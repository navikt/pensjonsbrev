{
  "name": "skribenten-web-frontend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "build": "tsc && vite build",
    "check-types": "tsc --noemit && tsc --noemit -p tsconfig.test.json && tsc --noemit -p tsconfig.e2e.json",
    "check-unit-test-location": "files=$(find . -path './node_modules' -prune -o -path './src' -prune -o \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -print); if [ -n \"$files\" ]; then echo 'Feilplasserte testfiler (må ligge under src/):'; echo \"$files\"; exit 1; fi",
    "dev": "vite --host",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:write": "biome check --write .",
    "lint-and-check-types": "${npm_execpath} run format && ${npm_execpath} run lint && ${npm_execpath} run stylelint && ${npm_execpath} run check-types",
    "preview": "vite preview",
    "stylelint": "stylelint 'src/**/*.{tsx,css}'",
    "stylelint:fix": "stylelint --fix 'src/**/*.{tsx,css}'",
    "test": "${npm_execpath} run check-unit-test-location && vitest --config ./vitest.config.ts",
    "tsc:watch": "tsc --watch",
    "verify": "${npm_execpath} run lint-and-check-types && ${npm_execpath} run test -- --run && ${npm_execpath} run e2e"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@hookform/resolvers": "5.9.1",
    "@navikt/aksel-icons": "8.16.2",
    "@navikt/ds-css": "8.16.2",
    "@navikt/ds-react": "8.16.2",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "axios": "1.20.0",
    "date-fns": "4.4.0",
    "dompurify": "3.4.16",
    "fuse.js": "7.5.0",
    "immer": "11.1.18",
    "lodash": "4.18.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-pdf": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@navikt/aksel-stylelint": "8.16.2",
    "@playwright/test": "1.63.0",
    "@tanstack/react-query-devtools": "5.103.2",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-vite-plugin": "1.167.40",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/lodash": "4.17.25",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "jsdom": "30.1.1",
    "lint-staged": "17.5.1",
    "openapi-typescript": "7.13.0",
    "postcss-styled-syntax": "0.7.2",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "@redocly/openapi-core": {
      "js-yaml": "^4.2.0"
    }
  }
}
