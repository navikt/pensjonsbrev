{
  "name": "brevoppskrift-web-frontend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.app.json && vite build",
    "check-types": "tsc --noemit -p tsconfig.app.json && tsc --noemit -p tsconfig.test.json && tsc --noemit -p tsconfig.node.json",
    "check-unit-test-location": "test -z \"$(find . -path './node_modules' -prune -o -path './src' -prune -o \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -print -quit)\"",
    "dev": "vite",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:write": "biome check --write .",
    "lint-and-check-types": "${npm_execpath} run format && ${npm_execpath} run lint && ${npm_execpath} run stylelint && ${npm_execpath} run check-types",
    "preview": "vite preview",
    "stylelint:fix": "stylelint --fix '**/*.{tsx,css}'",
    "stylelint": "stylelint '**/*.{tsx,css}'",
    "test": "${npm_execpath} run check-unit-test-location && vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@navikt/aksel-icons": "8.20.0",
    "@navikt/ds-css": "8.20.0",
    "@navikt/ds-react": "8.20.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "axios": "1.20.0",
    "docx": "9.14.0",
    "fuse.js": "7.5.0",
    "lodash": "4.18.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@navikt/aksel-stylelint": "8.20.0",
    "@tanstack/react-query-devtools": "5.105.0",
    "@tanstack/router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "jszip": "3.10.2",
    "lint-staged": "17.6.0",
    "postcss-styled-syntax": "0.7.4",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
