{
  "name": "brevoppskrift-web-frontend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "build": "tsc && vite build",
    "check-types": "tsc --noemit",
    "dev": "vite",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:write": "biome check --write .",
    "lint-and-check-types": "${npm_execpath} run format && ${npm_execpath} run lint && ${npm_execpath} run stylelint && ${npm_execpath} run check-types",
    "preview": "vite preview",
    "stylelint:fix": "stylelint --fix '**/*.{tsx,css}'",
    "stylelint": "stylelint '**/*.{tsx,css}'",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@navikt/aksel-icons": "8.16.1",
    "@navikt/ds-css": "8.16.1",
    "@navikt/ds-react": "8.16.1",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "axios": "1.19.0",
    "fuse.js": "^7.4.2",
    "lodash": "4.18.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@navikt/aksel-stylelint": "8.16.1",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/router-devtools": "1.167.0",
    "@tanstack/router-plugin": "1.168.23",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/lodash": "4.17.25",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "globals": "17.9.0",
    "jsdom": "^29.1.1",
    "lint-staged": "17.3.0",
    "postcss-styled-syntax": "0.7.2",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
