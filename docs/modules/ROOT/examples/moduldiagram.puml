@startuml

legend top left
  |<#pink><color:#pink>WWWWWWWWWW</color> | publisert artefakt konsumenten deklarerer selv |
  |<#mistyrose><color:#mistyrose>WWWWWWWWWW</color> | publisert artefakt, men kun ment som\ntransitiv avhengighet av et av de over |
  |<#lightskyblue><color:#lightskyblue>WWWWWWWWWW</color> | våre applikasjoner (kjørende tjenester) |
  |<#yellow><color:#yellow>WWWWWWWWWW</color> | eksternt system |
endlegend

package "brevbaker" {

  object "brevbaker:brevdata" as brevdata #mistyrose
  brevdata : - vokabularet en *bestiller* trenger for å\n  beskrive brevdata
  brevdata : - BrevbakerType, DisplayText, LanguageCode,\n  BrevLandmodell, Brevkode, LetterMetadata,\n  BrevbakerBrevdata-familien, SaksbehandlerValg,\n  IBrevkategori/ISakstype
  brevdata : - null avhengigheter, endres sjelden
  brevdata : - dette er alt PENs api-modeller kompilerer mot
  brevdata : - publiseres, men konsumenter får den via\n  api-modellene og brevbaker-api

  object "brevbaker:brevbaker-api" as brevbakerapi #pink
  brevbakerapi : - brevbakers HTTP-kontrakt (tidligere api-model-common)
  brevbakerapi : - alle DTOer bestillere trenger:\n  BestillBrevRequest, LetterResponse,\n  TemplateDescription, BrevbakerFelles,\n  TemplateModelSpecification, AlltidValgbartVedlegg
  brevbakerapi : - BestillRedigertBrevRequest V1/V2 —\n  derfor avhengig av markup:model
  brevbakerapi : - brevinnhold v1 i eget pakkenavn (LetterMarkup(+Impl),\n  LetterMarkupWithDataUsage(+Impl), Listetype,\n  ElementTags, AttachmentTitle) — slettes samlet når\n  siste konsument er over på markup v2

  package "brevbaker:markup" {
    object "brevbaker:markup:model" as markupModel #mistyrose
    markupModel : - ren datamodell for markup, ingen DSL
    markupModel : - ingen runtime-avhengigheter
    markupModel : - konstruktørene forblir internal\n  (@ConsistentCopyVisibility), så copy() er skjult\n  og valideringen kan ikke omgås
    markupModel : - eneste vei inn utenfra er en smal fabrikkflate\n  merket @MarkupModelApi (RequiresOptIn)
    markupModel : - eget versjonert artefakt fordi typene inngår i\n  signaturen til flere publiserte artefakter:\n  ABI-validert
    markupModel : - konsumenter får den transitivt, ikke ved\n  å deklarere den selv

    object "brevbaker:markup:dsl" as markupDsl #mistyrose
    markupDsl : - både den offentlige authoring-DSLen og den\n  utvidede (eksplisitte ids, variable,\n  editBehaviour) — én modul
    markupDsl : - den utvidede flaten er gatet med\n  @ExtendedMarkupDsl (RequiresOptIn) og ligger i\n  egne pakker, ikke skilt ut i egen modul
    markupDsl : - derfor forblir alle builder-sømmer internal:\n  ingen associateWith, ingen lekkasje av\n  texts/blocks/contentFactory/build()
    markupDsl : - publiseres, men konsumenter får den\n  via pdf-bygger:dsl
  }

  object "brevbaker:bom" as bom #pink
  bom : - brevbaker-bom (java-platform)
  bom : - alle publiserte artefakter slippes i lockstep\n  fra brevbakerVersion i rot-gradle.properties
  bom : - dekker brevdata, brevbaker-api, markup:model/dsl\n  og pdf-bygger:api/dsl
  bom : - inneholder ingen kode, kun versjons-constraints\n  for alle de publiserte artefaktene over
  bom : - importeres av konsumenter som bruker flere av\n  artefaktene, så delte typer som markup:model\n  ikke kan sprike i versjon

  object "brevbaker:jackson" as jackson
  jackson : - Jackson-serialisering av intern trafikk\n  (internalObjectMapper, MarkupJacksonModule)
  jackson : - re-eksporterer ingen modeller; konsumenter\n  deklarerer dem selv
  jackson : - publiseres aldri

  object "brevbaker:dsl" as dsl
  dsl : - det som trengs for å lage en mal

  object "brevbaker:core" as core
  core : - rendringsmotor, Letter2Markup
  core : - PDFByggerService-grensesnittet
  core : - bygger LetterPDFRequest via pdf-bygger:api\n  (opt-in @MarkupModelApi), som den får via jackson

  object "brevbaker:template-model-generator" as tmg
  tmg : - KSP: genererer *Selectors\n  fra @TemplateModelHelpers

  object "brevbaker:pdf-bygger:api" as pdfbyggerApi #mistyrose
  pdfbyggerApi : - kontrakten mot pdf-bygger:\n  PDFRequest, PDFCompilationOutput, HttpStatusCodes
  pdfbyggerApi : - avhenger kun av markup:model
  pdfbyggerApi : - publiseres, men konsumenter får den\n  via pdf-bygger:dsl

  object "brevbaker:pdf-bygger:dsl" as pdfbyggerDsl #pink
  pdfbyggerDsl : - DSL for å bygge en PDFRequest
  pdfbyggerDsl : - avhenger av markup:dsl og pdf-bygger:api

  object "brevbaker:pdf-bygger" as pdfbygger #lightskyblue
  pdfbygger : - egen tjeneste
  pdfbygger : - kompilerer Typst til PDF
}

package "maler" {
  object "pensjon:maler" as pensjonsmalene
  object "alder:maler" as aldersmalene
  object "ufoere:maler" as ufoeremalene
  object "etterlattemaler" as etterlatte
  object "planlegge-pensjon-maler" as planlegge
}

package "api-model" {
  object "pensjon:api-model" as pensjonapimodel #pink
  object "alder:api-model" as alderapimodel #pink
  object "ufoere:api-model" as ufoereapimodel #pink
}

object "pensjon:brevbaker" as brevbakerApp #lightskyblue
brevbakerApp : - applikasjonen som samler alle malene\n  og eksponerer dem via API

object "skribenten-backend" as skribenten #lightskyblue
object PEN #yellow
object Gjenny #yellow

' brevbaker-modulene
markupDsl --> markupModel
brevbakerapi --> brevdata
brevbakerapi --> markupModel : BestillRedigertBrevRequest v1/v2
pdfbyggerApi --> markupModel
pdfbyggerDsl --> markupDsl
pdfbyggerDsl --> pdfbyggerApi
jackson --> brevbakerapi
jackson --> pdfbyggerApi
dsl --> brevbakerapi
core --> dsl
core --> jackson
core --> markupDsl : opt-in @ExtendedMarkupDsl
tmg --> dsl
pdfbygger --> jackson

' malmoduler
pensjonsmalene --> core
aldersmalene --> core
ufoeremalene --> core
etterlatte --> core
planlegge --> core

pensjonsmalene --> pensjonapimodel
aldersmalene --> alderapimodel
ufoeremalene --> ufoereapimodel

pensjonapimodel --> brevdata
alderapimodel --> brevdata
ufoereapimodel --> brevdata

' applikasjonen
brevbakerApp --> pensjonsmalene
brevbakerApp --> aldersmalene
brevbakerApp --> ufoeremalene
brevbakerApp --> etterlatte
brevbakerApp --> planlegge
brevbakerApp ..> pdfbygger : HTTP
PEN ..> brevbakerApp : HTTP
Gjenny ..> brevbakerApp : HTTP
skribenten ..> brevbakerApp : HTTP


' konsumenter
skribenten --> jackson
PEN --> pensjonapimodel
PEN --> alderapimodel
PEN --> ufoereapimodel
PEN --> brevbakerapi
Gjenny --> brevbakerapi

@enduml
